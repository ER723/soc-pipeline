# Copy to .env (gitignored) and fill in real values.
SOC_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
SOC_HMAC_SECRET=
SOC_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_TOKEN
# Generate SOC_HMAC_SECRET with: openssl rand -hex 32
# Set the same value as HMAC_SECRET in Apps Script's Script Properties.
